{
  "$comment": [
    "Language-neutral conformance fixtures for ANLA-MVP v0.1.",
    "Both reference implementations read this file, pack the same trees with the",
    "same plan and the same fixed (uuid, created_ns), and the suite then asserts",
    "byte equality between them. Nothing here is generated by either of them.",
    "File content is given as `text` (UTF-8), `base64`, or `repeat`.",
    "Paths are given as `path`, or as `path_codepoints` — a list of Unicode",
    "scalar values. The second form exists because the interesting Unicode cases",
    "(a precomposed/decomposed pair, an emoji with a variation selector) are",
    "exactly the ones an editor or a filesystem might silently normalize. A byte",
    "exactness test whose fixture can be rewritten in transit tests nothing."
  ],
  "trees": {
    "basic": {
      "name": "basic",
      "directories": ["docs"],
      "files": [
        { "path": "docs/readme.txt", "text": "ANLA cross-implementation fixture\n", "mtime_ns": "1700000000000000000" },
        { "path": "data.bin", "base64": "AQIDBAECAwQ=", "mtime_ns": "1700000001000000000" }
      ]
    },
    "empty-archive": {
      "name": "empty-archive",
      "directories": [],
      "files": []
    },
    "empty-file": {
      "name": "empty-file",
      "directories": ["hollow"],
      "files": [
        { "path": "hollow/nothing.txt", "text": "", "mtime_ns": "1700000002000000000" },
        { "path": "one-byte.bin", "base64": "AA==", "mtime_ns": "1700000003000000000" }
      ]
    },
    "duplicate-content": {
      "name": "duplicate-content",
      "directories": ["a", "b"],
      "files": [
        { "path": "a/same.txt", "text": "identical content across two paths\n", "mtime_ns": "1700000004000000000" },
        { "path": "b/same.txt", "text": "identical content across two paths\n", "mtime_ns": "1700000005000000000" },
        { "path": "b/different.txt", "text": "not the same\n", "mtime_ns": "1700000006000000000" }
      ]
    },
    "split-file": {
      "name": "split-file",
      "directories": [],
      "files": [
        { "path": "chunked.bin", "repeat": { "pattern_base64": "ANLA", "length": 10000 }, "mtime_ns": "1700000007000000000" },
        { "path": "tail.bin", "repeat": { "pattern_base64": "//8A", "length": 4097 }, "mtime_ns": "1700000008000000000" }
      ]
    },
    "unicode-paths": {
      "name": "unicode-paths",
      "$comment": "CJK directory, emoji with U+FE0F, an NFC/NFD pair, a case-only pair",
      "directories_codepoints": [[25991, 20214], [101, 109, 111, 106, 105]],
      "files": [
        {
          "$name": "CJK path",
          "path_codepoints": [25991, 20214, 47, 26371, 35441, 48, 49, 46, 116, 120, 116],
          "text": "traditional chinese path\n",
          "mtime_ns": "1700000009000000000"
        },
        {
          "$name": "emoji with variation selector",
          "path_codepoints": [101, 109, 111, 106, 105, 47, 128452, 65039, 45, 97, 46, 116, 120, 116],
          "text": "emoji in a path\n",
          "mtime_ns": "1700000010000000000"
        },
        {
          "$name": "NFC: e-acute as one code point",
          "path_codepoints": [99, 97, 102, 233, 45, 110, 102, 99, 46, 116, 120, 116],
          "text": "precomposed\n",
          "mtime_ns": "1700000011000000000"
        },
        {
          "$name": "NFD: e followed by combining acute",
          "path_codepoints": [99, 97, 102, 101, 769, 45, 110, 102, 100, 46, 116, 120, 116],
          "text": "decomposed\n",
          "mtime_ns": "1700000012000000000"
        },
        { "path": "Sample.TXT", "text": "uppercase\n", "mtime_ns": "1700000013000000000" },
        { "path": "sample.txt", "text": "lowercase\n", "mtime_ns": "1700000014000000000" }
      ]
    },
    "compressible": {
      "name": "compressible",
      "directories": ["logs"],
      "files": [
        { "path": "logs/repetitive.log", "repeat": { "pattern_base64": "YWJjYWJjYWJjYWJjCg==", "length": 65536 }, "mtime_ns": "1700000015000000000" },
        { "path": "logs/incompressible.bin", "base64": "3q2+7wABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj9AQUJDREVGR0hJSktMTU5PUFFSU1RVVldYWVpbXF1eX2BhYmNkZWZnaGlqa2xtbm9wcXJzdHV2d3h5ent8fX5/", "mtime_ns": "1700000016000000000" }
      ]
    },
    "excluded": {
      "name": "excluded",
      "directories": [".git", ".git/objects", "node_modules", "src"],
      "files": [
        { "path": ".git/config", "text": "should be excluded\n", "mtime_ns": "1700000017000000000" },
        { "path": ".git/objects/deep/blob", "text": "excluded only by a ** pattern\n", "mtime_ns": "1700000018000000000" },
        { "path": "node_modules/pkg/index.js", "text": "excluded by **\n", "mtime_ns": "1700000019000000000" },
        { "path": "src/main.js", "text": "kept\n", "mtime_ns": "1700000020000000000" },
        { "path": "notes.md", "text": "kept too\n", "mtime_ns": "1700000021000000000" }
      ]
    }
  },
  "cases": [
